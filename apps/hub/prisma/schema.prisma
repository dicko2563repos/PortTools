generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["porttools", "public", "movements"]
}

model AuthPort {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  name             String
  loginEmail       String?  @unique @map("login_email")
  remindersEnabled Boolean  @default(false) @map("reminders_enabled")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  credentials AuthPortCredential?

  @@schema("porttools")
  @@map("ports")
}

model AuthPortCredential {
  portId       String   @id @map("port_id") @db.Uuid
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  port AuthPort @relation(fields: [portId], references: [id], onDelete: Cascade)

  @@schema("porttools")
  @@map("port_credentials")
}

model ReportsUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@schema("porttools")
  @@map("reports_users")
}

model PublicPort {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique

  @@schema("public")
  @@map("ports")
}

model MovementsPort {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique

  @@schema("movements")
  @@map("ports")
}
