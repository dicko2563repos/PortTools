generator client {

  provider = "prisma-client-js"

}



datasource db {

  provider = "postgresql"

  url      = env("DATABASE_URL")

  schemas  = ["porttools", "movements"]

}



enum SentStatus {

  not_sent

  sent



  @@schema("movements")

}



enum FobHolderType {

  staff

  visitor



  @@schema("movements")

}



enum FobDeviceEventType {

  renamed

  deleted

  restored



  @@schema("movements")

}



model AuthPort {

  id        String   @id @default(uuid()) @db.Uuid

  code      String   @unique

  name      String

  loginEmail        String?  @unique @map("login_email")

  remindersEnabled  Boolean  @default(false) @map("reminders_enabled")

  isActive  Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)



  credentials AuthPortCredential?

  managerAccess ManagerPortAccess[]



  @@schema("porttools")

  @@map("ports")

}



model AuthPortCredential {

  portId       String   @id @map("port_id") @db.Uuid

  passwordHash String   @map("password_hash")

  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)



  port AuthPort @relation(fields: [portId], references: [id], onDelete: Cascade)



  @@schema("porttools")

  @@map("port_credentials")

}



model AuthAdmin {

  id           String   @id @default(uuid()) @db.Uuid

  email        String   @unique

  passwordHash String   @map("password_hash")

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)



  passwordResetTokens AdminPasswordResetToken[]



  @@schema("porttools")

  @@map("admins")

}



model AdminPasswordResetToken {

  id        String    @id @default(uuid()) @db.Uuid

  adminId   String    @map("admin_id") @db.Uuid

  tokenHash String    @map("token_hash")

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)

  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)



  admin AuthAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)



  @@index([tokenHash])

  @@index([adminId])

  @@schema("porttools")

  @@map("admin_password_reset_tokens")

}



model ReportsUser {

  id           String   @id @default(uuid()) @db.Uuid

  email        String   @unique

  passwordHash String   @map("password_hash")

  isActive     Boolean  @default(true) @map("is_active")

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)



  @@schema("porttools")

  @@map("reports_users")

}



model Manager {

  id           String   @id @default(uuid()) @db.Uuid

  email        String   @unique

  passwordHash String   @map("password_hash")

  isActive     Boolean  @default(true) @map("is_active")

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)



  portAccess ManagerPortAccess[]



  @@schema("porttools")

  @@map("managers")

}



model ManagerPortAccess {

  managerId String @map("manager_id") @db.Uuid

  portId    String @map("port_id") @db.Uuid



  manager Manager  @relation(fields: [managerId], references: [id], onDelete: Cascade)

  port    AuthPort @relation(fields: [portId], references: [id], onDelete: Cascade)



  @@id([managerId, portId])

  @@schema("porttools")

  @@map("manager_port_access")

}



model Port {

  id        String   @id @default(uuid()) @db.Uuid

  code      String   @unique

  name      String

  emailTo   String   @default("") @map("email_to")

  isActive  Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)



  movementYears  MovementYear[]

  regularFlights RegularFlight[]

  staffAsicRecords StaffAsicRecord[]

  fobDevices       FobDevice[]

  fobCheckouts     FobCheckout[]



  @@schema("movements")

  @@map("ports")

}



model MovementYear {

  id        String   @id @default(uuid()) @db.Uuid

  portId    String   @map("port_id") @db.Uuid

  year      Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)



  port    Port             @relation(fields: [portId], references: [id], onDelete: Cascade)

  periods MovementPeriod[]



  @@unique([portId, year])

  @@schema("movements")

  @@map("movement_years")

}



model MovementPeriod {

  id             String     @id @default(uuid()) @db.Uuid

  movementYearId String     @map("movement_year_id") @db.Uuid

  label          String

  startDate      DateTime   @map("start_date") @db.Date

  endDate        DateTime   @map("end_date") @db.Date

  sortOrder      Int        @map("sort_order")

  sentStatus     SentStatus @default(not_sent) @map("sent_status")

  sentAt         DateTime?  @map("sent_at") @db.Timestamptz(6)



  movementYear MovementYear    @relation(fields: [movementYearId], references: [id], onDelete: Cascade)

  entries      MovementEntry[]



  @@unique([movementYearId, sortOrder])

  @@schema("movements")

  @@map("movement_periods")

}



model MovementEntry {

  id           String   @id @default(uuid()) @db.Uuid

  periodId     String   @map("period_id") @db.Uuid

  movementDate DateTime @map("movement_date") @db.Date

  airline      String   @default("")

  service      String   @default("")

  aircraftRego String   @default("") @map("aircraft_rego")

  flightNumber String   @default("") @map("flight_number")

  onTime       String   @default("") @map("on_time")

  delayMin     Int?     @map("delay_min")

  comment      String   @default("")

  sortOrder    Int      @default(0) @map("sort_order")

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)



  period MovementPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)



  @@schema("movements")

  @@map("movement_entries")

}



model RegularFlight {

  id           String   @id @default(uuid()) @db.Uuid

  portId       String   @map("port_id") @db.Uuid

  flightNumber String   @map("flight_number")

  service      String   @default("")

  airline      String   @default("")

  sortOrder    Int      @default(0) @map("sort_order")

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)



  port Port @relation(fields: [portId], references: [id], onDelete: Cascade)



  @@unique([portId, flightNumber])

  @@schema("movements")

  @@map("regular_flights")

}



model StaffAsicRecord {

  id         String   @id @default(uuid()) @db.Uuid

  portId     String   @map("port_id") @db.Uuid

  name       String

  asicNumber String   @map("asic_number")

  expiryDate DateTime @map("expiry_date") @db.Date

  notes      String   @default("")

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)



  port      Port          @relation(fields: [portId], references: [id], onDelete: Cascade)

  checkouts FobCheckout[]



  @@unique([portId, asicNumber])

  @@schema("movements")

  @@map("staff_asic_records")

}



model FobDevice {

  id        String    @id @default(uuid()) @db.Uuid

  portId    String    @map("port_id") @db.Uuid

  label     String

  notes     String    @default("")

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)



  port         Port             @relation(fields: [portId], references: [id], onDelete: Cascade)

  checkouts    FobCheckout[]

  deviceEvents FobDeviceEvent[]



  @@unique([portId, label])

  @@schema("movements")

  @@map("fob_devices")

}



model FobCheckout {

  id                String        @id @default(uuid()) @db.Uuid

  fobDeviceId       String        @map("fob_device_id") @db.Uuid

  portId            String        @map("port_id") @db.Uuid

  holderType        FobHolderType @map("holder_type")

  staffAsicRecordId String?       @map("staff_asic_record_id") @db.Uuid

  visitorName           String        @default("") @map("visitor_name")

  visitorOrganization   String        @default("") @map("visitor_organization")

  reason            String        @default("")

  notes             String        @default("")

  signedOutAt       DateTime      @default(now()) @map("signed_out_at") @db.Timestamptz(6)

  signedInAt        DateTime?     @map("signed_in_at") @db.Timestamptz(6)



  fobDevice FobDevice        @relation(fields: [fobDeviceId], references: [id], onDelete: Cascade)

  port      Port             @relation(fields: [portId], references: [id], onDelete: Cascade)

  staffAsic StaffAsicRecord? @relation(fields: [staffAsicRecordId], references: [id], onDelete: SetNull)



  @@index([fobDeviceId, signedInAt])

  @@index([portId, signedInAt])

  @@schema("movements")

  @@map("fob_checkouts")

}



model FobDeviceEvent {

  id          String             @id @default(uuid()) @db.Uuid

  fobDeviceId String             @map("fob_device_id") @db.Uuid

  portId      String             @map("port_id") @db.Uuid

  eventType   FobDeviceEventType @map("event_type")

  oldLabel    String?            @map("old_label")

  newLabel    String?            @map("new_label")

  notes       String             @default("")

  adminEmail  String             @default("") @map("admin_email")

  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)



  fobDevice FobDevice @relation(fields: [fobDeviceId], references: [id], onDelete: Cascade)



  @@index([fobDeviceId, createdAt])

  @@schema("movements")

  @@map("fob_device_events")

}


