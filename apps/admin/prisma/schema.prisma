generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["porttools"]
}

model AuthPort {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  credentials   AuthPortCredential?
  managerAccess ManagerPortAccess[]

  @@schema("porttools")
  @@map("ports")
}

model AuthPortCredential {
  portId       String   @id @map("port_id") @db.Uuid
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  port AuthPort @relation(fields: [portId], references: [id], onDelete: Cascade)

  @@schema("porttools")
  @@map("port_credentials")
}

model AuthAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  passwordResetTokens AdminPasswordResetToken[]

  @@schema("porttools")
  @@map("admins")
}

model AdminPasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  admin AuthAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([adminId])
  @@schema("porttools")
  @@map("admin_password_reset_tokens")
}

model Manager {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  portAccess ManagerPortAccess[]

  @@schema("porttools")
  @@map("managers")
}

model ManagerPortAccess {
  managerId String @map("manager_id") @db.Uuid
  portId    String @map("port_id") @db.Uuid

  manager Manager  @relation(fields: [managerId], references: [id], onDelete: Cascade)
  port    AuthPort @relation(fields: [portId], references: [id], onDelete: Cascade)

  @@id([managerId, portId])
  @@schema("porttools")
  @@map("manager_port_access")
}
