generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["porttools", "public"]
}

model AuthPort {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  name             String
  loginEmail       String?  @unique @map("login_email")
  complianceReminderEmailsEnabled Boolean @default(false) @map("compliance_reminder_emails_enabled")
  asicReminderEmailsEnabled       Boolean @default(false) @map("asic_reminder_emails_enabled")
  pmsLastDayReminderEmailsEnabled Boolean @default(true) @map("pms_last_day_reminder_emails_enabled")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  credentials   AuthPortCredential?
  accessPin     AuthPortAccessPin?
  managerAccess ManagerPortAccess[]

  @@schema("porttools")
  @@map("ports")
}

model AuthPortCredential {
  portId       String   @id @map("port_id") @db.Uuid
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  port AuthPort @relation(fields: [portId], references: [id], onDelete: Cascade)

  @@schema("porttools")
  @@map("port_credentials")
}

model AuthPortAccessPin {
  portId    String   @id @map("port_id") @db.Uuid
  pinHash   String   @map("pin_hash")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  port AuthPort @relation(fields: [portId], references: [id], onDelete: Cascade)

  @@schema("porttools")
  @@map("port_access_pins")
}

model AuthAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  passwordResetTokens AdminPasswordResetToken[]

  @@schema("porttools")
  @@map("admins")
}

model AdminPasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  admin AuthAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([adminId])
  @@schema("porttools")
  @@map("admin_password_reset_tokens")
}

model Manager {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  portAccess ManagerPortAccess[]

  @@schema("porttools")
  @@map("managers")
}

model ManagerPortAccess {
  managerId String @map("manager_id") @db.Uuid
  portId    String @map("port_id") @db.Uuid

  manager Manager  @relation(fields: [managerId], references: [id], onDelete: Cascade)
  port    AuthPort @relation(fields: [portId], references: [id], onDelete: Cascade)

  @@id([managerId, portId])
  @@schema("porttools")
  @@map("manager_port_access")
}

model ReportsUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  receivePmsReports Boolean @default(false) @map("receive_pms_reports")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@schema("porttools")
  @@map("reports_users")
}

enum ComplianceRecordStatus {
  draft
  archived

  @@schema("public")
}

model Port {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  complianceRecords ComplianceRecord[]

  @@schema("public")
  @@map("ports")
}

model InspectionTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  version     Int
  name        String
  definition  Json
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  isActive    Boolean  @default(false) @map("is_active")

  complianceRecords ComplianceRecord[]

  @@unique([version])
  @@schema("public")
  @@map("inspection_templates")
}

model ComplianceRecord {
  id                String                 @id @default(uuid()) @db.Uuid
  portId            String                 @map("port_id") @db.Uuid
  year              Int
  templateVersionId String                 @map("template_version_id") @db.Uuid
  status            ComplianceRecordStatus @default(draft)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  port            Port               @relation(fields: [portId], references: [id], onDelete: Cascade)
  templateVersion InspectionTemplate @relation(fields: [templateVersionId], references: [id])

  @@unique([portId, year])
  @@schema("public")
  @@map("compliance_records")
}
